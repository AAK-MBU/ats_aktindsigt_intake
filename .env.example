# DEV ENVIRONMENT
TZ=Europe/Copenhagen

# ----------------------------------------------------------------------------
# Automation Server
# ----------------------------------------------------------------------------
ATS_TOKEN=INSERT_TOKEN_HERE
ATS_URL=INSERT_URL_HERE
ATS_CAPABILITIES=

# The intake queue this run drains is chosen by ATS (ats.workqueue()); locally,
# override it with the intake queue's id. OS2Forms, the aktindsigt URL and the
# webforms are set in ats_framework/processes/intake_config.py.
ATS_WORKQUEUE_OVERRIDE=WORKQUEUE_ID

# Absolute path to the ATS CA certificate (PEM). It is appended to the public
# roots (see ats_framework/helpers/config.apply_ca_bundle). Leave empty to use
# the default trust store.
AARHUS_ROOT_CERT_PEM=

# ----------------------------------------------------------------------------
# RPA database (the OS2Forms api-key, the aktindsigt intake API key and the
# framework's error-mail constants) — read by mbu_rpa_core.RPAConnection
# ----------------------------------------------------------------------------
DBCONNECTIONSTRINGPROD=Driver=INSERT_CONN_STRING_HERE
